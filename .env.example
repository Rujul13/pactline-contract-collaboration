# Local-only values. Never use NEXT_PUBLIC_ for secrets.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Public Worker owner fallback. Production deployment stores the derived values in D1.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_PASSWORD_HASH=
OWNER_SESSION_SECRET=

# Cloudflare resource names. GitHub Actions selects isolated staging names off main.
CLOUDFLARE_D1_DATABASE_NAME=pactline-contracts
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET_NAME=pactline-documents
